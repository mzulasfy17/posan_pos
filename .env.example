# ===================================================================
# POSAN Mobile Environment Configuration Example
# Salin file ini menjadi `.env` lalu sesuaikan parameternya:
# ===================================================================

# 1. Menggunakan Kabel USB (ADB Reverse):
# Jalankan: adb reverse tcp:3000 tcp:3000
BASE_URL=http://127.0.0.1:3000/api

# 2. Menggunakan Jaringan Wi-Fi lokal:
# BASE_URL=http://192.168.123.75:3000/api

# 3. Server Production:
# BASE_URL=https://api.posan.id/api
